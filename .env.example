# =====================================================================
#  REQUIRED to start chatting (Step 3)
# =====================================================================

# Telegram: token from @BotFather, your numeric id from getUpdates / @getmyid_bot
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_OWNER_ID=123456789

# DeepSeek: key from platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# Optional but recommended: web search (brave.com/search/api)
BRAVE_API_KEY=

# You
OWNER_NAME=Eray
# Your own mobile number in E.164 (+ country code, no spaces)
OWNER_PHONE=+905321234567
# e.g. Europe/London, Europe/Istanbul, Europe/Berlin
OWNER_TIMEZONE=Europe/London

# =====================================================================
#  Brain settings (defaults are fine)
# =====================================================================

# "deepseek" (cheap, default) or "anthropic" (Claude). Switching starts a fresh conversation.
BRAIN_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
# api.deepseek.com is hosted in China. For EU hosting of the same model use:
#   DEEPSEEK_BASE_URL=https://api.eurouter.ai/api/v1   (with an EUrouter key)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# "none" = no hidden reasoning (much faster). "default" turns it back on.
DEEPSEEK_REASONING_EFFORT=none

# Claude: only needed when BRAIN_PROVIDER=anthropic (console.anthropic.com).
# The voice on calls is Claude too, but that's chosen and billed inside Retell, not here.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# =====================================================================
#  PHONE CALLS (later steps). Leave empty until then; calls stay off.
# =====================================================================

# Public HTTPS address of this server (ngrok locally, Fly/Railway in production).
# Empty = the bot fetches Telegram messages itself (fine for chatting).
PUBLIC_BASE_URL=
# Any long random string (optional; generated automatically if empty)
TELEGRAM_WEBHOOK_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use the Retell API key that has the webhook badge
RETELL_API_KEY=
RETELL_AGENT_ID=

DB_PATH=agent.db
ASK_OWNER_TIMEOUT=60
