# --- Brain (Telegram chats) ---
# "deepseek" (cheap, default) or "anthropic" (Claude). Switching starts a fresh conversation.
BRAIN_PROVIDER=deepseek

# DeepSeek: key from platform.deepseek.com (you can reuse Reservay's key)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-flash
# api.deepseek.com is hosted in China. For EU hosting of the same model use:
#   DEEPSEEK_BASE_URL=https://api.eurouter.ai/api/v1   (with an EUrouter key)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# "none" = no hidden reasoning (much faster). "default" turns it back on.
DEEPSEEK_REASONING_EFFORT=none
# Optional: web search for DeepSeek (brave.com/search/api). Without it, DeepSeek can still open URLs.
BRAVE_API_KEY=

# Claude: only needed when BRAIN_PROVIDER=anthropic (console.anthropic.com)
# The voice on calls is Claude too, but that's chosen and billed inside Retell, not here.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Telegram (create a bot with @BotFather; get your id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_OWNER_ID=123456789
# Any long random string; Telegram sends it back so we know requests are real
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Public HTTPS URL of this server (ngrok URL locally, your Fly/Railway URL in production)
PUBLIC_BASE_URL=https://your-agent.example.com

# --- You ---
OWNER_NAME=Eray
# Your own mobile number in E.164. Verify it in Twilio as an outgoing caller ID (see README).
OWNER_PHONE=+905321234567
OWNER_TIMEZONE=Europe/Istanbul

# --- Twilio (places the calls, shows your number) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# --- Retell (voice AI on the call) ---
# Use the Retell API key that has the webhook badge: it also verifies webhook signatures
RETELL_API_KEY=key_...
RETELL_AGENT_ID=agent_...

DB_PATH=agent.db
ASK_OWNER_TIMEOUT=60
